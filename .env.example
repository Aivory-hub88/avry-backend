# Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/aivery

# Service Configuration
PORT=XXXX
ENVIRONMENT=development

# JWT
JWT_SECRET=your_secret_key_here

# Logging
LOG_LEVEL=INFO

# Telegram bots — shared default plus per-agent overrides
# (TELEGRAM_BOT_TOKEN_<AGENT_TYPE_UPPER>). Without an override the agent
# falls back to the shared bot. Aira has its own bot:
# TELEGRAM_BOT_TOKEN_CHIEF_OF_STAFF=<bot-token-here>
# TELEGRAM_BOT_USERNAME_CHIEF_OF_STAFF=<bot-username-here>
# e.g. TELEGRAM_BOT_TOKEN_CUSTOMER_SERVICE / TELEGRAM_BOT_USERNAME_CUSTOMER_SERVICE

# API Keys (as needed)
# API_KEY=your_api_key_here
# OPENROUTER_KEY=your_key_here
# MIDTRANS_SERVER_KEY=your_key_here
# MIDTRANS_CLIENT_KEY=your_key_here
